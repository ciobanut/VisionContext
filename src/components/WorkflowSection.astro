---
import { Step1Mockup, Step2Mockup, Step3Mockup } from './Mockups';
---
<section class="py-20 px-6 max-w-7xl mx-auto">
  <div class="text-center mb-16">
    <h2 class="text-3xl md:text-4xl font-medium text-slate-900 mb-4">A simple, three-step workflow</h2>
    <p class="text-slate-500">
      Go from asset to production in seconds with our integrated toolchain.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <!-- Step 1 Card -->
    <div class="bg-white rounded-[2rem] p-8 shadow-sm border border-slate-100 flex flex-col hover:shadow-xl transition-all duration-500 group">
      <div class="w-10 h-10 rounded-full bg-slate-900 text-white flex items-center justify-center text-sm font-medium mb-8 group-hover:scale-110 transition-transform">
        01
      </div>
      <div class="mb-8 h-40 flex items-center justify-center">
        <Step1Mockup />
      </div>
      <h3 class="text-xl font-medium text-slate-900 mb-3">Connect your tools</h3>
      <p class="text-slate-500 text-sm leading-relaxed">
        Install our lightweight plugins for Adobe Creative Cloud or Figma to start syncing your
        assets directly.
      </p>
    </div>

    <!-- Step 2 Card -->
    <div class="bg-white rounded-[2rem] p-8 shadow-sm border border-slate-100 flex flex-col hover:shadow-xl transition-all duration-500 group">
      <div class="w-10 h-10 rounded-full bg-slate-900 text-white flex items-center justify-center text-sm font-medium mb-8 group-hover:scale-110 transition-transform">
        02
      </div>
      <div class="mb-8 h-40 flex items-center justify-center">
        <Step2Mockup />
      </div>
      <h3 class="text-xl font-medium text-slate-900 mb-3">AI Processing</h3>
      <p class="text-slate-500 text-sm leading-relaxed">
        Vortex analyzes your visuals in the background, generating contextually aware meta-data and
        optimizations.
      </p>
    </div>

    <!-- Step 3 Card -->
    <div class="bg-white rounded-[2rem] p-8 shadow-sm border border-slate-100 flex flex-col hover:shadow-xl transition-all duration-500 group">
      <div class="w-10 h-10 rounded-full bg-slate-900 text-white flex items-center justify-center text-sm font-medium mb-8 group-hover:scale-110 transition-transform">
        03
      </div>
      <div class="mb-8 h-40 flex items-center justify-center">
        <Step3Mockup />
      </div>
      <h3 class="text-xl font-medium text-slate-900 mb-3">Ship and Analyze</h3>
      <p class="text-slate-500 text-sm leading-relaxed">
        Deploy your assets with confidence and monitor engagement and accessibility health in
        real-time.
      </p>
    </div>
  </div>
</section>