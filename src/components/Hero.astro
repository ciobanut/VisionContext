---

---

<section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden">
  {/* Background decoration */}
  <div
    class="absolute top-0 right-0 -z-10 w-1/2 h-full bg-gradient-to-l from-blue-50/50 to-transparent"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      <div class="lg:col-span-7 text-center lg:text-left">
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 border border-blue-100 text-blue-600 text-xs font-black uppercase tracking-widest mb-8"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"
            ></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"
            ></span>
          </span>
          AI Alt Text that understands context
        </div>
        <h1
          class="text-5xl md:text-6xl lg:text-7xl font-serif font-medium tracking-tight mb-8 text-slate-900 leading-[0.95]"
        >
          Alt text that actually <br />
          <span class="italic text-blue-600">helps users</span>.
        </h1>
        <p
          class="max-w-xl mx-auto lg:mx-0 text-xl text-slate-500 mb-10 leading-relaxed font-light"
        >
          Automatically generate accurate, relevant, WCAG-compliant alt text —
          using the <span class="text-slate-900 font-medium">real context</span> of
          your page, not generic AI guesses.
        </p>

        <div
          class="flex flex-col sm:flex-row gap-6 justify-center lg:justify-start items-center"
        >
          <a
            href="#tool"
            class="w-full sm:w-auto px-7 py-4 bg-slate-900 text-white rounded-full font-bold text-lg hover:bg-slate-800 transition-all shadow-xl shadow-slate-900/20 flex items-center justify-center gap-2"
          >
            <span class="material-icons-round text-lg"
              >wordpress</span
            >
            Get Free WordPress Plugin
          </a>
          <a href="#"
            class="w-full sm:w-auto px-7 py-4 bg-white border border-slate-200 text-slate-900 rounded-full font-bold text-lg hover:bg-slate-50 transition-all flex items-center justify-center gap-2"
          >
            See how it works
          </a>
        </div>

        <div
          class="mt-12 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 sm:gap-8 opacity-70"
        >
          <div
            class="flex items-center gap-2 text-slate-600 font-bold text-xs uppercase tracking-wide"
          >
            <span class="material-icons-round text-blue-500 text-lg">bolt</span> Built
            for WordPress & WooCommerce
          </div>
          <div class="hidden sm:block w-px h-4 bg-slate-200"></div>
          <div
            class="flex items-center gap-2 text-slate-600 font-bold text-xs uppercase tracking-wide"
          >
            <span class="material-icons-round text-blue-500 text-lg"
              >verified</span
            > No hallucinations
          </div>
        </div>
      </div>

      <div class="lg:col-span-5 relative">
        <div class="relative animate-float">
          {/* Context Mockup */}
          <div
            class="bg-white rounded-2xl shadow-2xl border border-slate-200 relative z-10 overflow-hidden group"
          >
            <div
              class="p-4 bg-slate-50 rounded-t-[2rem] border-b border-slate-100 flex items-center justify-between"
            >
              <div class="flex items-center gap-1.5">
                <div class="w-2 h-2 rounded-full bg-slate-300"></div>
                <div class="w-2 h-2 rounded-full bg-slate-300"></div>
                <div class="w-2 h-2 rounded-full bg-slate-300"></div>
              </div>
              <div
                class="text-[10px] font-bold text-slate-400 uppercase tracking-widest"
              >
                WordPress Media Library
              </div>
            </div>
            <div class="p-6 space-y-6">
              <div
                class="relative aspect-video rounded-xl overflow-hidden bg-slate-100"
              >
                <img
                  src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0?auto=format&fit=crop&w=800&q=80"
                  class="w-full h-full object-cover"
                  alt="Team meeting"
                />
                <div class="scan-line"></div>
              </div>
              <div class="space-y-4">
                <div
                  class="p-4 bg-blue-50 rounded-xl border border-blue-100 relative"
                >
                  <div
                    class="absolute -top-3 right-4 px-2 py-0.5 bg-blue-500 text-white text-[8px] font-black uppercase rounded"
                  >
                    98% Match
                  </div>
                  <p
                    class="text-[10px] font-black text-blue-400 uppercase tracking-widest mb-1"
                  >
                    Generated Context
                  </p>
                  <p
                    class="text-sm italic font-serif text-blue-900 leading-relaxed"
                  >
                    "Marketing team discussing Q4 strategy in a collaborative
                    open office setting."
                  </p>
                </div>
                <div class="p-4 bg-slate-50 rounded-xl border border-slate-200">
                  <p
                    class="text-[10px] font-black text-slate-700 uppercase tracking-widest mb-1"
                  >
                    Generic AI Guess (Others)
                  </p>
                  <p class="text-sm italic font-serif text-slate-500">
                    "People sitting around a table."
                  </p>
                </div>
              </div>
            </div>
          </div>

          {/* Decorative blobs */}
          <div
            class="absolute -top-12 -right-12 w-64 h-64 bg-blue-500/10 rounded-full blur-3xl -z-10"
          >
          </div>
          <div
            class="absolute -bottom-12 -left-12 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl -z-10"
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
