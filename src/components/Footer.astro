---
import Logo from "../components/Logo.astro";
---

<footer class="bg-slate-950 text-slate-400 py-12 border-t border-slate-900">
  <div
    class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-6"
  >
    <div class="flex items-center gap-2">
      <Logo />
    </div>
    <div class="flex gap-8 text-sm">
      <a class="hover:text-white transition-colors" href="#">Privacy</a>
      <a class="hover:text-white transition-colors" href="#">Terms</a>
      <a class="hover:text-white transition-colors" href="#">Twitter</a>
      <a class="hover:text-white transition-colors" href="#">Contact</a>
    </div>
    <div class="text-sm">© {new Date().getFullYear()} VisionContext Inc.</div>
  </div>
</footer>
