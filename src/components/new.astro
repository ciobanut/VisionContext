---
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import ToolsSection from '../components/ToolsSection.astro';

import {
    Navbar,
    HeroTwoColumn,
    ProblemSection,
    WorkflowSection,
    AnalyticsSection,
    FeaturesGrid,
    FinalCTASection,
    Footer
} from '../components/Sections.astro';
---



    <div class="min-h-screen bg-white selection:bg-blue-100">
      <Navigation />
      
      {/* 1. Hero Section */}
      <Hero />



                      <HeroTwoColumn />
                      <ProblemSection />
                      <WorkflowSection />
                      <AnalyticsSection />
                      <FeaturesGrid />
                      <FinalCTASection />
                      <Footer />
                      
      {/* Trust Micro-copy */}
      <div class="bg-slate-50 border-y border-slate-100 py-6 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 flex flex-wrap justify-center gap-8 md:gap-16 text-[11px] font-black text-slate-400 uppercase tracking-[0.2em]">
          <div class="flex items-center gap-2"><span class="material-icons-round text-blue-500 text-sm">verified</span> Context-aware AI</div>
          <div class="flex items-center gap-2"><span class="material-icons-round text-blue-500 text-sm">verified</span> Bulk processing without timeouts</div>
          <div class="flex items-center gap-2"><span class="material-icons-round text-blue-500 text-sm">verified</span> Full control & transparency</div>
        </div>
      </div>

      {/* 2. The Problem Section */}
      <section class="py-24 md:py-32">
        <div class="max-w-7xl mx-auto px-4">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <div class="order-2 lg:order-1">
              <div class="relative aspect-square max-w-md mx-auto">
                <div class="absolute inset-0 bg-blue-600/5 rounded-full blur-3xl"></div>
                <div class="relative glass p-8 rounded-[2rem] border border-slate-200 shadow-2xl">
                   <h4 class="text-sm font-bold text-red-500 uppercase tracking-widest mb-6">Current Reality</h4>
                   <div class="space-y-4">
                      <div class="p-4 bg-white rounded-xl border border-red-100 flex items-center gap-4 animate-pulse">
                        <span class="material-icons-round text-red-400">warning</span>
                        <div class="flex-1 space-y-2">
                          <div class="h-2 w-24 bg-slate-100 rounded"></div>
                          <div class="h-2 w-full bg-slate-50 rounded"></div>
                        </div>
                      </div>
                      <div class="p-4 bg-white rounded-xl border border-slate-100 opacity-50">
                        <div class="h-2 w-32 bg-slate-100 rounded mb-2"></div>
                        <div class="h-2 w-48 bg-slate-50 rounded"></div>
                      </div>
                      <div class="p-4 bg-white rounded-xl border border-slate-100 opacity-30">
                        <div class="h-2 w-16 bg-slate-100 rounded mb-2"></div>
                        <div class="h-2 w-40 bg-slate-50 rounded"></div>
                      </div>
                   </div>
                   <div class="mt-8 pt-8 border-t border-slate-100">
                     <p class="text-xs text-slate-600 italic font-medium leading-relaxed">
                       "Most plugins deliver generic guesses that can be worse than having no alt text at all."
                     </p>
                   </div>
                </div>
              </div>
            </div>
            <div class="order-1 lg:order-2 space-y-8">
              <h2 class="text-5xl md:text-6xl font-serif leading-[1.1]">
                Thousands of images.<br />
                <span class="italic text-slate-400">No time. Real legal risk.</span>
              </h2>
              <div class="space-y-6 text-slate-500 text-lg font-light leading-relaxed">
                <p>If you run a modern WordPress site, you have hundreds or thousands of images. You know alt text is <span class="text-slate-900 font-bold">mandatory</span> (accessibility + SEO), but you keep postponing it because it’s repetitive and time-consuming.</p>
                <ul class="space-y-4">
                  <li class="flex gap-3 items-start"><span class="text-red-500 mt-1">❌</span> Generic or incorrect descriptions</li>
                  <li class="flex gap-3 items-start"><span class="text-red-500 mt-1">❌</span> Confusing credit systems</li>
                  <li class="flex gap-3 items-start"><span class="text-red-500 mt-1">❌</span> Results that damage screen-reader experiences</li>
                </ul>
                <p class="text-blue-600 font-bold text-xl pt-4">👉 That’s not automation. That’s a lottery.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* 3. The Solution Section */}
      <section class="py-24 bg-slate-900 text-white relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none" style={{backgroundImage: 'radial-gradient(#3B82F6 1px, transparent 1px)', backgroundSize: '40px 40px'}}></div>
        <div class="max-w-4xl mx-auto px-4 text-center relative z-10">
          <h2 class="text-4xl md:text-6xl font-serif mb-8">Intelligent automation — <br/><span class="italic opacity-60">not blind automation</span></h2>
          <p class="text-xl text-slate-400 font-light mb-12 max-w-2xl mx-auto leading-relaxed">
            This plugin doesn’t just describe what’s in the image. It understands <span class="text-white font-medium italic">why</span> the image exists on your page.
          </p>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {['Page & Post Titles', 'SEO Focus Keywords', 'Surrounding Content', 'WooCommerce Context'].map((item) => (
              <div class="p-4 rounded-2xl bg-white/5 border border-white/10 text-sm font-bold">
                {item}
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* 4. Functional Lab Section */}
      <ToolsSection />

      {/* 5. Feature Showcase Grid */}
      <section class="py-24 bg-slate-50 border-y border-slate-100">
        <div class="max-w-7xl mx-auto px-4">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {/* Feature 1 */}
            <div class="bg-white p-8 rounded-[2rem] border border-slate-200 shadow-sm hover:shadow-xl transition-all group">
              <div class="w-14 h-14 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                <span class="material-icons-round text-3xl">psychology</span>
              </div>
              <h3 class="text-xl font-bold mb-4">Context-Aware AI</h3>
              <p class="text-slate-500 text-sm leading-relaxed mb-6">
                “Woman typing on a laptop” <span class="text-red-400">❌</span><br/>
                “Freelance writer creating content in the WordPress block editor” <span class="text-green-500">✅</span>
              </p>
              <div class="text-[10px] font-black text-blue-600 uppercase tracking-widest">Semantic Understanding</div>
            </div>

            {/* Feature 2 */}
            <div class="bg-white p-8 rounded-[2rem] border border-slate-200 shadow-sm hover:shadow-xl transition-all group">
              <div class="w-14 h-14 bg-amber-50 text-amber-600 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                <span class="material-icons-round text-3xl">verified</span>
              </div>
              <h3 class="text-xl font-bold mb-4">Confidence Score</h3>
              <p class="text-slate-500 text-sm leading-relaxed mb-6">
                Every generated alt text comes with a score. High score = auto-approved. Medium = flagged for review. You control the thresholds.
              </p>
              <div class="w-full bg-slate-100 h-1.5 rounded-full overflow-hidden">
                <div class="bg-amber-500 h-full w-[92%] animate-[shimmer_2s_infinite]"></div>
              </div>
            </div>

            {/* Feature 3 */}
            <div class="bg-white p-8 rounded-[2rem] border border-slate-200 shadow-sm hover:shadow-xl transition-all group">
              <div class="w-14 h-14 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                <span class="material-icons-round text-3xl">auto_awesome_motion</span>
              </div>
              <h3 class="text-xl font-bold mb-4">Decorative Detection</h3>
              <p class="text-slate-500 text-sm leading-relaxed mb-6">
                Dividers, UI icons, and backgrounds shouldn't be described. Our AI automatically sets alt="" for noise reduction.
              </p>
              <div class="text-[10px] font-black text-indigo-600 uppercase tracking-widest">WCAG Compliance</div>
            </div>

            {/* Feature 4 */}
            <div class="bg-white p-8 rounded-[2rem] border border-slate-200 shadow-sm hover:shadow-xl transition-all group">
              <div class="w-14 h-14 bg-slate-900 text-white rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                <span class="material-icons-round text-3xl">dataset_linked</span>
              </div>
              <h3 class="text-xl font-bold mb-4">Stress-Free Bulk</h3>
              <p class="text-slate-500 text-sm leading-relaxed mb-6">
                Works the same for 10 or 10,000 images. Asynchronous background processing ensures no server timeouts or site slowdowns.
              </p>
            </div>

            {/* Feature 5 */}
            <div class="bg-white p-8 rounded-[2rem] border border-slate-200 shadow-sm hover:shadow-xl transition-all group lg:col-span-2">
              <div class="flex flex-col lg:flex-row gap-8 items-center">
                <div class="flex-1">
                  <div class="w-14 h-14 bg-green-50 text-green-600 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                    <span class="material-icons-round text-3xl">grid_view</span>
                  </div>
                  <h3 class="text-xl font-bold mb-4">Visual Media Status</h3>
                  <p class="text-slate-500 text-sm leading-relaxed">
                    See what’s fixed instantly inside your Media Library with visual status dots. 🟢 OK, 🟡 Review, 🔴 Missing, 🎨 Decorative.
                  </p>
                </div>
                <div class="flex-1 w-full bg-slate-50 rounded-2xl border border-slate-100 p-4 space-y-3">
                   {[1,2,3].map(i => (
                     <div key={i} class="flex items-center gap-3 bg-white p-2 rounded-lg border border-slate-100">
                        <div class="w-8 h-8 bg-slate-100 rounded"></div>
                        <div class="flex-1 h-2 bg-slate-50 rounded"></div>
                        <div class={`w-2 h-2 rounded-full ${i===1?'bg-green-500':i===2?'bg-amber-500':'bg-red-500'}`}></div>
                     </div>
                   ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* 6. WooCommerce Section */}
      <section class="py-24 bg-white">
        <div class="max-w-7xl mx-auto px-4">
          <div class="bg-gradient-to-br from-blue-600 to-indigo-700 rounded-[3rem] p-8 md:p-16 text-white overflow-hidden relative">
            <div class="absolute top-0 right-0 w-64 h-64 bg-white/10 blur-[100px] -mr-20 -mt-20"></div>
            <div class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
              <div>
                <span class="px-4 py-1.5 rounded-full bg-white/20 text-sm font-bold mb-6 inline-block">WooCommerce First</span>
                <h2 class="text-4xl md:text-5xl font-serif mb-6 leading-tight">Built for e-commerce,<br/> not just blogs</h2>
                <p class="text-blue-100 text-lg font-light mb-8 leading-relaxed">
                  The plugin intelligently pulls product titles, attributes (color, material, etc.), and specific product page context to make your products eligible for Google Images and visual searches.
                </p>
                <div class="flex flex-wrap gap-4">
                  <div class="flex items-center gap-2 text-sm font-bold"><span class="material-icons-round text-blue-200">check_circle</span> Product SEO</div>
                  <div class="flex items-center gap-2 text-sm font-bold"><span class="material-icons-round text-blue-200">check_circle</span> High Intent Traffic</div>
                  <div class="flex items-center gap-2 text-sm font-bold"><span class="material-icons-round text-blue-200">check_circle</span> Conversions</div>
                </div>
              </div>
              <div class="bg-white/10 backdrop-blur-md rounded-3xl p-6 border border-white/20">
                <div class="p-4 bg-white rounded-2xl text-slate-900 shadow-2xl">
                   <div class="flex gap-4 mb-4">
                      <div class="w-16 h-16 bg-slate-100 rounded-lg"></div>
                      <div class="space-y-2 flex-1 pt-1">
                        <div class="h-4 w-3/4 bg-slate-100 rounded"></div>
                        <div class="h-3 w-1/2 bg-slate-50 rounded"></div>
                      </div>
                   </div>
                   <div class="p-3 bg-blue-50 rounded-lg border border-blue-100">
                      <p class="text-[10px] font-black text-blue-400 uppercase tracking-widest mb-1">Generated for Woo</p>
                      <p class="text-xs font-medium italic">"Mens organic cotton t-shirt in Navy Blue, athletic fit..."</p>
                   </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* 7. Transparency Section */}
      <section class="py-24 bg-slate-50 border-t border-slate-100">
        <div class="max-w-4xl mx-auto px-4 text-center">
          <h2 class="text-3xl font-serif mb-6">Transparency & Ethics</h2>
          <p class="text-slate-500 mb-12">No phantom credit usage. No hidden failures. You see exactly what is sent and what is saved.</p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-left">
             <div class="space-y-2">
                <div class="font-bold text-slate-900 text-sm">Full Audit Trail</div>
                <p class="text-xs text-slate-400">Every AI response is logged for your review.</p>
             </div>
             <div class="space-y-2">
                <div class="font-bold text-slate-900 text-sm">Strict WCAG Adherence</div>
                <p class="text-xs text-slate-400">We prioritize human-friendly descriptions over keywords.</p>
             </div>
             <div class="space-y-2">
                <div class="font-bold text-slate-900 text-sm">Local Execution First</div>
                <p class="text-xs text-slate-400">Minimal data footprint for maximum privacy.</p>
             </div>
          </div>
        </div>
      </section>

      {/* 8. Final CTA & Pricing Teaser */}
      <section class="py-32 bg-white relative">
        <div class="max-w-4xl mx-auto px-4 text-center">
          <div class="inline-block px-4 py-1.5 rounded-full bg-slate-900 text-white text-[10px] font-black uppercase tracking-widest mb-10">Pricing Design</div>
          <h2 class="text-5xl md:text-7xl font-serif mb-8">Free to start.<br/><span class="italic text-blue-600">Fair by design.</span></h2>
          <p class="text-xl text-slate-500 font-light mb-12 max-w-xl mx-auto">
            100 free images every month. No forced subscriptions. Pay-as-you-go credits that <span class="text-slate-900 font-bold">never expire</span>.
          </p>
          <div class="flex flex-col sm:flex-row justify-center gap-6">
             <button class="px-12 py-5 bg-blue-600 text-white rounded-full font-bold text-xl hover:bg-blue-700 transition-all shadow-2xl shadow-blue-500/30">
                Automate it now
             </button>
             <button class="px-12 py-5 bg-white border border-slate-200 text-slate-900 rounded-full font-bold text-xl hover:bg-slate-50 transition-all">
                See Live Demo
             </button>
          </div>
          <p class="mt-12 text-slate-400 text-sm italic font-light">Accessibility shouldn’t come with hidden costs.</p>
        </div>
      </section>

      {/* Footer */}
      <footer class="py-12 border-t border-slate-100 bg-slate-50">
        <div class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-6">
          <div class="flex items-center gap-2">
             <div class="w-8 h-8 bg-slate-900 rounded-lg flex items-center justify-center text-white font-bold text-xs">A</div>
             <span class="font-bold tracking-tight text-slate-900">AltText.ai</span>
          </div>
          <div class="flex gap-10 text-sm font-medium text-slate-500">
            <a href="#" class="hover:text-blue-600 transition-colors">API Status</a>
            <a href="#" class="hover:text-blue-600 transition-colors">Privacy</a>
            <a href="#" class="hover:text-blue-600 transition-colors">ADA Guide</a>
            <a href="#" class="hover:text-blue-600 transition-colors">Support</a>
          </div>
          <p class="text-slate-400 text-[10px] uppercase tracking-widest font-black">Built with Gemini 3 Pro</p>
        </div>
      </footer>
    </div>
  );
};

export default App;
