


    <section id="tool" class="py-24 bg-white relative">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-px h-24 bg-gradient-to-b from-slate-200 to-transparent"></div>
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-16">
          <div class="inline-block px-4 py-1 bg-blue-50 text-blue-600 rounded-full text-[10px] font-black uppercase tracking-widest mb-6 border border-blue-100">Live Lab</div>
          <h2 class="text-5xl font-serif font-medium mb-6">See it in action.</h2>
          <p class="text-slate-500 max-w-2xl mx-auto text-lg font-light">
            Upload any image and experience how our AI identifies context and WCAG decorative status.
          </p>
        </div>

        <div class="bg-slate-50/50 rounded-[3rem] border border-slate-200 p-6 md:p-10 shadow-2xl backdrop-blur-xl">
          <div class="flex flex-wrap gap-2 mb-10 justify-center p-1.5 bg-slate-200/50 rounded-2xl w-fit mx-auto">
            <button 
              onClick={() => setMode(ToolMode.ANALYZE)}
              class={`px-8 py-3 rounded-xl font-bold transition-all text-sm flex items-center gap-2 ${mode === ToolMode.ANALYZE ? 'bg-white text-blue-600 shadow-sm' : 'text-slate-500 hover:text-slate-700'}`}
            >
              <span class="material-icons-round text-lg">radar</span> Audit & Predict
            </button>
            <button 
              onClick={() => setMode(ToolMode.EDIT)}
              class={`px-8 py-3 rounded-xl font-bold transition-all text-sm flex items-center gap-2 ${mode === ToolMode.EDIT ? 'bg-white text-blue-600 shadow-sm' : 'text-slate-500 hover:text-slate-700'}`}
            >
              <span class="material-icons-round text-lg">auto_fix_high</span> Smart Modifier
            </button>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
            {/* Input Side */}
            <div class="space-y-6">
              <div 
                class={`relative aspect-[4/3] rounded-3xl border-2 border-dashed flex flex-col items-center justify-center transition-all overflow-hidden bg-white group
                ${image ? 'border-blue-200' : 'border-slate-300 hover:border-blue-400'}`}
              >
                {image ? (
                  <div class="relative w-full h-full">
                    {loading && <div class="scan-line"></div>}
                    <img src={image} alt="Preview" class="w-full h-full object-contain" />
                  </div>
                ) : (
                  <div class="text-center p-12 space-y-4">
                    <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center mx-auto text-slate-300 group-hover:scale-110 transition-transform">
                      <span class="material-icons-round text-4xl">add_photo_alternate</span>
                    </div>
                    <div>
                      <p class="text-slate-900 font-bold">Select test image</p>
                      <p class="text-slate-400 text-sm">Upload a product or blog asset</p>
                    </div>
                  </div>
                )}
                <input 
                  type="file" 
                  ref={fileInputRef}
                  onChange={handleFileUpload}
                  class="absolute inset-0 opacity-0 cursor-pointer" 
                  accept="image/*"
                />
              </div>
              
              <div class="flex gap-4">
                <button 
                  onClick={() => fileInputRef.current?.click()}
                  class="flex-1 px-6 py-4 bg-white border border-slate-200 rounded-2xl font-bold hover:bg-slate-50 transition-colors text-slate-700"
                >
                  Change Asset
                </button>
                {mode === ToolMode.ANALYZE ? (
                  <button 
                    disabled={!image || loading}
                    onClick={runAnalysis}
                    class="flex-[2] px-6 py-4 bg-blue-600 text-white rounded-2xl font-bold hover:bg-blue-700 disabled:opacity-50 transition-all flex items-center justify-center gap-3 shadow-lg shadow-blue-600/20"
                  >
                    {loading ? (
                      <div class="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                    ) : (
                      <>
                        <span class="material-icons-round">bolt</span>
                        Run Smart Audit
                      </>
                    )}
                  </button>
                ) : (
                  <div class="flex-[2] flex gap-2">
                    <input 
                      type="text"
                      placeholder="e.g. 'Make it a sketch'..."
                      value={editPrompt}
                      onChange={(e) => setEditPrompt(e.target.value)}
                      onKeyDown={(e) => e.key === 'Enter' && runEdit()}
                      class="flex-1 px-6 py-4 rounded-2xl border border-slate-200 focus:outline-none focus:ring-4 focus:ring-blue-100 bg-white"
                    />
                    <button 
                      disabled={!image || !editPrompt || loading}
                      onClick={runEdit}
                      class="px-6 bg-slate-900 text-white rounded-2xl font-bold hover:bg-slate-800 disabled:opacity-50 transition-all"
                    >
                      Apply
                    </button>
                  </div>
                )}
              </div>
            </div>

            {/* Result Side */}
            <div class="bg-white rounded-3xl border border-slate-200 p-8 shadow-sm flex flex-col h-full relative overflow-hidden">
              {error && (
                <div class="mb-6 p-4 bg-red-50 text-red-600 rounded-2xl text-sm font-bold flex items-center gap-3 border border-red-100">
                  <span class="material-icons-round">warning</span> {error}
                </div>
              )}

              {loading && !result && (
                <div class="flex-1 flex flex-col items-center justify-center space-y-6">
                  <div class="relative">
                    <div class="w-16 h-16 border-4 border-blue-600/10 rounded-full"></div>
                    <div class="absolute inset-0 w-16 h-16 border-4 border-blue-600 border-t-transparent rounded-full animate-spin"></div>
                  </div>
                  <div class="text-center">
                    <p class="text-slate-900 font-bold">Identifying context signals...</p>
                  </div>
                </div>
              )}

              {!loading && !result && (
                <div class="flex-1 flex flex-col items-center justify-center text-center space-y-6">
                  <div class="w-20 h-20 bg-slate-50 rounded-3xl flex items-center justify-center text-slate-300">
                    <span class="material-icons-round text-5xl">auto_awesome</span>
                  </div>
                  <div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Audit Dashboard</h3>
                    <p class="text-slate-400 text-sm max-w-xs mx-auto">Upload an image to see how the context engine works in real-time.</p>
                  </div>
                </div>
              )}

              {result && mode === ToolMode.ANALYZE && (
                <div class="space-y-8 animate-in fade-in duration-500">
                  <div class="flex justify-between items-start">
                    <div class="px-3 py-1 bg-green-50 text-green-600 text-[10px] font-black uppercase tracking-widest rounded-full border border-green-100 flex items-center gap-1">
                      <span class="material-icons-round text-xs">verified</span> Optimized
                    </div>
                    <div class="flex items-center gap-1.5">
                       <div class="w-2 h-2 rounded-full bg-green-500"></div>
                       <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Media Status: OK</span>
                    </div>
                  </div>
                  
                  <div>
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest flex justify-between">
                       Context-Aware Alt Text
                       <span class="text-blue-600">98% Confidence</span>
                    </label>
                    <div class="mt-3 p-5 bg-blue-50/50 border border-blue-100 rounded-2xl text-slate-900 font-medium relative group">
                      <p class="leading-relaxed">{result.altText}</p>
                    </div>
                  </div>

                  <div>
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">WCAG Decorative Analysis</label>
                    <p class="mt-3 text-slate-600 text-sm leading-relaxed font-light">
                      This image contains high semantic value. <span class="text-green-600 font-bold">Informative status confirmed.</span> No alt="" null required.
                    </p>
                  </div>

                  <div>
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">SEO Semantic Tags</label>
                    <div class="mt-3 flex flex-wrap gap-2">
                      {result.tags.map((tag, idx) => (
                        <span key={idx} class="px-4 py-1.5 bg-slate-50 text-slate-600 text-xs font-bold rounded-full border border-slate-200">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>

                  <div class="pt-8 mt-4 border-t border-slate-100 flex items-center justify-between">
                    <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">0.4s response time</p>
                    <button class="text-blue-600 text-sm font-bold hover:underline flex items-center gap-1">
                      Bulk Sync <span class="material-icons-round text-sm">sync</span>
                    </button>
                  </div>
                </div>
              )}

              {mode === ToolMode.EDIT && (
                <div class="flex-1 flex flex-col items-center justify-center text-center space-y-8 animate-in fade-in">
                   <div class="relative">
                      <div class="w-20 h-20 bg-indigo-50 text-indigo-600 rounded-[2rem] flex items-center justify-center animate-pulse">
                        <span class="material-icons-round text-4xl">magic_button</span>
                      </div>
                   </div>
                   <div class="space-y-3">
                     <h3 class="font-bold text-slate-900 text-xl">Generative Canvas</h3>
                     <p class="text-slate-400 text-sm max-w-xs mx-auto leading-relaxed">
                       Modify your visual assets using natural language to match your site's aesthetic style.
                     </p>
                   </div>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
    ---