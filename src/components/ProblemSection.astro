---
import { ProblemMockup } from './Mockups';
---
<section class="py-24 px-6 bg-slate-50">
  <div class="max-w-7xl mx-auto flex flex-col items-center text-center">
    <div class="max-w-3xl mb-16">
      <h2 class="text-3xl md:text-5xl font-medium text-slate-900 mb-6">
        Accessibility shouldn't be <br />an afterthought.
      </h2>
      <p class="text-lg text-slate-500 leading-relaxed">
        Millions of users rely on screen readers to navigate the web. Without accurate alt text, your
        visual assets are invisible to them—and search engines.
      </p>
    </div>
    <div class="relative w-full flex justify-center py-10">
      <ProblemMockup />
    </div>
  </div>
</section>