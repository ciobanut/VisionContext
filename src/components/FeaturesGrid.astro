---
import FeatureCard from './FeatureCard.astro';
import { BuildMockup, CodeMockup } from './Mockups';
---
<section class="py-20 px-6 max-w-7xl mx-auto">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <FeatureCard
      number="#1"
      subtitle="BUILD AND RELEASE"
      title="Eliminate developer frustration"
      description="Accelerate development by letting us handle the infrastructure. Build your Electron app on Mac, Windows, and Linux with confidence."
    >
      <BuildMockup />
    </FeatureCard>

    <FeatureCard
      number="#2"
      subtitle="SIMPLIFY BUILDS"
      title="Identify code vulnerabilities"
      description="We analyze your Electron app's source code to find and rank issues by severity. Quickly resolve vulnerabilities with confidence."
    >
      <CodeMockup />
    </FeatureCard>
  </div>
</section>