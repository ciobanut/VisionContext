---
import { DashboardMockup } from './Mockups';
---
<section class="py-24 px-6 overflow-hidden">
  <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-center gap-16">
    <div class="flex-1 w-full flex justify-center lg:justify-start">
      <DashboardMockup />
    </div>
    <div class="flex-1 text-left">
      <h2 class="text-3xl md:text-5xl font-medium text-slate-900 mb-6 leading-tight">
        Monitor your health with <br />
        <span class="text-indigo-600">Precision Analytics.</span>
      </h2>
      <p class="text-lg text-slate-500 mb-8 leading-relaxed">
        Get real-time insights into your media library's accessibility score. Our dashboard tracks
        indexing progress, error rates, and SEO impact across all platforms.
      </p>
    </div>
  </div>
</section>