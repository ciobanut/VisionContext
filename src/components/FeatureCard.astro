---
const { number, title, subtitle, description } = Astro.props;
---
<div class="bg-white rounded-[2.5rem] p-8 md:p-12 shadow-sm border border-slate-100 flex flex-col h-full group hover:shadow-xl transition-all duration-500">
  <div class="flex items-center justify-between text-xs font-medium text-slate-400 tracking-widest uppercase mb-12">
    <span>{subtitle}</span>
    <span>{number}</span>
  </div>

  <div class="flex-grow flex items-center justify-center mb-12 min-h-[320px]">
    <slot />
  </div>

  <div class="text-center">
    <h3 class="text-2xl font-medium text-slate-900 mb-4">{title}</h3>
    <p class="text-slate-500 leading-relaxed text-sm md:text-base">
      {description}
    </p>
  </div>
</div>