---
const grid8 = Array.from({ length: 8 });

---

<section class="py-24 px-6 max-w-5xl mx-auto">
  <div
    class="bg-white rounded-[3rem] p-12 md:p-20 text-center shadow-[0_40px_80px_-20px_rgba(0,0,0,0.1)] border border-slate-100 flex flex-col items-center gap-12 group transition-all duration-700 hover:shadow-[0_50px_100px_-20px_rgba(0,0,0,0.15)]"
  >


    <div class="w-full max-w-lg flex flex-col items-center">
      <div class="grid grid-cols-3 md:grid-cols-4 gap-4 w-full">
        {grid8.map((_, i) => (
          <div class="relative aspect-square rounded-2xl bg-white border border-slate-100 shadow-sm flex items-center justify-center group overflow-hidden">
            <svg
              class="w-8 h-8 text-slate-100"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
              />
            </svg>
            <div class="absolute top-2 right-2 w-5 h-5 rounded-full bg-green-500 border-2 border-white shadow-sm flex items-center justify-center transition-transform group-hover:scale-125">
              <svg
                class="w-3 h-3 text-white"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="4"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M5 13l4 4L19 7"
                />
              </svg>
            </div>
            <div class="absolute inset-0 bg-green-50/20 opacity-0 group-hover:opacity-100 transition-opacity" />
          </div>
        ))}
      </div>
    </div>


    <div class="max-w-2xl">
      <h2 class="text-4xl md:text-5xl font-display text-slate-900 mb-8">
        Ready to automate your <br />
        <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-600"
        >
          accessibility workflow?
        </span>
      </h2>
      <p class="text-xl text-slate-500 mb-10 leading-relaxed">
        Join 10,000+ teams who have already indexed over 2 million assets with
        100% WCAG compliance.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
        <button
          class="w-full sm:w-auto px-10 py-5 bg-indigo-600 text-white font-medium rounded-2xl hover:bg-indigo-700 transition-all shadow-xl shadow-indigo-200 text-lg"
        >
          Start indexing for free
        </button>
        <button
          class="w-full sm:w-auto px-10 py-5 bg-slate-50 text-slate-700 font-medium rounded-2xl hover:bg-slate-100 transition-all text-lg border border-slate-200"
        >
          Talk to an expert
        </button>
      </div>
    </div>
  </div>
</section>
