---
import { FinalSuccessMockup } from './Mockups';
---
<section class="py-24 px-6 max-w-5xl mx-auto">
  <div class="bg-white rounded-[3rem] p-12 md:p-20 text-center shadow-[0_40px_80px_-20px_rgba(0,0,0,0.1)] border border-slate-100 flex flex-col items-center gap-12 group transition-all duration-700 hover:shadow-[0_50px_100px_-20px_rgba(0,0,0,0.15)]">
    <FinalSuccessMockup />

    <div class="max-w-2xl">
      <h2 class="text-4xl md:text-5xl font--medium text-slate-900 mb-8">
        Ready to automate your <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-600">
          accessibility workflow?
        </span>
      </h2>
      <p class="text-xl text-slate-500 mb-10 leading-relaxed">
        Join 10,000+ teams who have already indexed over 2 million assets with 100% WCAG compliance.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
        <button class="w-full sm:w-auto px-10 py-5 bg-indigo-600 text-white font-medium rounded-2xl hover:bg-indigo-700 transition-all shadow-xl shadow-indigo-200 text-lg">
          Start indexing for free
        </button>
        <button class="w-full sm:w-auto px-10 py-5 bg-slate-50 text-slate-700 font-medium rounded-2xl hover:bg-slate-100 transition-all text-lg border border-slate-200">
          Talk to an expert
        </button>
      </div>
    </div>
  </div>
</section>