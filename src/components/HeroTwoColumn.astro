---
import AltTextMockup from './Mockups.astro';
---
<section class="pt-32 pb-20 px-6 max-w-7xl mx-auto flex flex-col md:flex-row items-center gap-16">
  <div class="flex-1 text-left">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 text-indigo-600 text-xs font-semibold mb-8">
      <span class="w-2 h-2 rounded-full bg-indigo-600 animate-pulse"></span>
      AI-Powered Asset Management
    </div>

    <h1 class="text-5xl lg:text-7xl font-medium text-slate-900 leading-[1.1] mb-8">
      Make your images <br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-600">
        universally accessible.
      </span>
    </h1>

    <p class="text-xl text-slate-500 max-w-xl mb-12 leading-relaxed">
      Vortex automatically generates precise, context-aware alt text for your entire media library,
      boosting SEO and ensuring perfect accessibility compliance.
    </p>

    <div class="flex flex-col sm:flex-row items-center gap-5">
      <button class="w-full sm:w-auto px-8 py-4 bg-indigo-600 text-white font-bold rounded-2xl hover:bg-indigo-700 transition-all shadow-xl shadow-indigo-200 text-lg">
        Try AI Generation
      </button>
      <button class="w-full sm:w-auto px-8 py-4 bg-white text-slate-700 border border-slate-200 font-bold rounded-2xl hover:bg-slate-50 transition-all shadow-sm text-lg flex items-center justify-center gap-2">
        <svg class="w-5 h-5 text-slate-400" fill="currentColor" viewBox="0 0 20 20">
          <path
            d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM14.553 7.106A1 1 0 0014 8v4a1 1 0 00.553.894l2 1A1 1 0 0018 13V7a1 1 0 00-1.447-.894l-2 1z"
          />
        </svg>
        Watch demo
      </button>
    </div>
  </div>

  <div class="flex-1 w-full flex justify-center items-center">
    <AltTextMockup variant="alt-text" />
  </div>
</section>